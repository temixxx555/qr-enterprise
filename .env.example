# Run npm run setup:local to generate a private local secret.
# Keep credentials out of source control and NEXT_PUBLIC_* variables.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=enterpriseqr
MONGODB_DB=enterpriseqr
BETTER_AUTH_SECRET=

# Hosted environment: APP_MODE=production, HTTPS APP_URL, MongoDB replica set.
# Production signup requires verified email; local mail goes to .data/mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Private S3-compatible bucket. Local mode can use .data/assets instead.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Phase 7: VTPass sandbox only; live delivery is intentionally disabled.
# Configure through private .env.local / host secret storage. Never NEXT_PUBLIC_*.
VTPASS_SANDBOX_ENABLED=false
VTPASS_SANDBOX_API_KEY=
VTPASS_SANDBOX_SECRET_KEY=
