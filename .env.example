# Run npm run setup:local to generate a private local secret.
# Keep credentials out of source control and NEXT_PUBLIC_* variables.
APP_MODE=local
APP_URL=http://127.0.0.1:3000
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=enterpriseqr
MONGODB_DB=enterpriseqr
BETTER_AUTH_SECRET=

# Hosted account and recovery mail. Local mode writes messages only to .data/mail.
RESEND_API_KEY=
MAIL_FROM=

# Required for image uploads and authorized image delivery in all environments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 7: VTPass sandbox only; live delivery is intentionally disabled.
# Configure through private .env.local / host secret storage. Never NEXT_PUBLIC_*.
VTPASS_SANDBOX_ENABLED=false
VTPASS_SANDBOX_API_KEY=PK_4130d1e6f8dc4b3be60f5fac30f7e12b582722fad9c
VTPASS_SANDBOX_SECRET_KEY=SK_71709b6b3784e68f816ef2d44033076ffedc5965b3a
